{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "taurus-viewer",
  "version": "0.1.0",
  "identifier": "io.github.sheepla.taurus-viewer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "taurus-viewer",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' taurus-page: taurus-thumb: http://taurus-page.localhost http://taurus-thumb.localhost asset: http://asset.localhost blob: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "pdfium.dll"
    ]
  }
}
